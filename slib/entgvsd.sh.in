#!/bin/sh -
#
# Script to build an run an EntGVSD Fortran "script", eg like in src/ directory.

set -e

# https://archive.is/TRzn4
while getopts ":pdv:l:c:h:b:" opt; do
  case $opt in
    d)
      echo "Debug mode set: will run on only small region" >&2
      ENTGVSD_DEBUG="-DENTGVSD_DEBUG"
      ;;
    p)
      echo "Will just write dependencies, will not run" >&2
      JUST_DEPENDENCIES="-DJUST_DEPENDENCIES"
      ;;
    v) # version number
      echo "Using version ${OPTARG}" >&2
      VERSION="-DV${OPTARG}"
      ;;
    l) # lai source
      echo "Using data source ${OPTARG} for LAI" >&2
      LAI="-DLAI_${OPTARG}"
      ;;
    c) # lc source
      echo "Using data source ${OPTARG} for LC" >&2
      LC="-DLC_${OPTARG}"
      ;;
    h) # hgt source
      echo "Using data source ${OPTARG} for HGT" >&2
      HGT="-DHGT_${OPTARG}"
      ;;
    b) # biomass source
      echo "Using data source ${OPTARG} for BIOMASS" >&2
      BIOMASS="-DBIOMASS_${OPTARG}"
      ;;
    :)
      echo "Option -$OPTARG requires an argument" >&2
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      ;;
  esac
done

fortran_source=${@AT@:$OPTIND:1}

a_out=$(mktemp)

shift

# http://redsymbol.net/articles/bash-exit-traps/
function finish {
    rm "$a_out"
}
trap finish EXIT

#LLP0="$LD_LIBRARY_PATH"
#export LD_LIBRARY_PATH=

@CMAKE_Fortran_COMPILER@ -cpp $JUST_DEPENDENCIES $ENTGVSD_DEBUG $VERSION $LAI $LC $HGT $BIOMASS \
    -I@CMAKE_INSTALL_PREFIX@/include \
    -I@NETCDF4_FORTRAN_INCLUDE_DIR@ \
    @FFLAGS@ \
    -o $a_out $fortran_source \
    @CMAKE_INSTALL_PREFIX@/lib/libentgvsd@CMAKE_SHARED_LIBRARY_SUFFIX@ \
    @NETCDF4_FORTRAN_LIBRARY@ @NETCDF4_C_LIBRARY@ \
    -Wl,-rpath,@CMAKE_INSTALL_PREFIX@/lib \
    -Wl,-rpath,@NETCDF4_FORTRAN_LIB_DIR@ \
    -Wl,-rpath,@NETCDF4_C_LIB_DIR@

#export LD_LIBRARY_PATH="$LLP0"

if [ $? -eq 0 ]; then
    $a_out "$@"
fi
